# Copy to .env and adjust. Never commit .env.

# --- App (used by `npm run dev` on your machine) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://spk:spk_dev_password@localhost:5432/spk_bansos?schema=public
UPLOAD_DIR=uploads

# --- Seed (fictional dev accounts) ---
SEED_PASSWORD=password123

# --- Docker Compose (db service) ---
POSTGRES_USER=spk
POSTGRES_PASSWORD=spk_dev_password
POSTGRES_DB=spk_bansos
DB_PORT=5432
# Path to the frontend repo, relative to this folder (used by the `web` service)
WEB_PATH=../../Frontend/spk-bansos-web
